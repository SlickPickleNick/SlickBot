{
  "name": "slickbot",
  "version": "0.9.8",
  "private": true,
  "description": "SlickBot all-in-one Discord server management bot with support workflows, moderation, permissions, achievements, community games, forum-backed FAQ, leveling, role panels, automation, and voice tools.",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/entrypoint.js",
    "start:bot": "node src/index.js",
    "start:dashboard": "node dashboard/server.js",
    "deploy:commands": "node src/deployCommands.js",
    "deploy:commands:global": "node src/deployCommands.js --global",
    "deploy:clean": "node src/scripts/purgeGuildCommands.js",
    "db:init": "node src/services/initDatabase.js",
    "validate:commands": "node src/scripts/validateCommands.js",
    "dashboard": "node dashboard/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3"
  },
  "packageManager": "npm@10.9.2"
}
